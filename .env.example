# Environment Configuration Example
# Copy to .env and fill in your values

# Gemini API Keys (Required for Gemini AI features, Assistant, and Macro Synthesis)
GEMINI_API_KEY=
VITE_GEMINI_API_KEY=
VITE_GEMINI_API_KEY_2=
VITE_GEMINI_API_KEY_3=

# Finnhub API Key for live global economic calendar
FINNHUB_API_KEY=""

# Twelve Data API Key for live asset spot prices and yields
TWELVEDATA_API_KEY=""

# Google Serper API Key for Live News Intel (https://google.serper.dev)
SERPER_API_KEY=""

# NewsAPI Key for global financial news (https://newsapi.org)
NEWSAPI_KEY=""

# Comma-separated list of trusted institutional RSS feeds (optional override)
RSS_FALLBACK="https://www.reuters.com/rssFeed/businessNews,https://www.cnbc.com/id/100003114/device/rss/rss.xml,https://www.forexlive.com/feed/"

# Set to true to run 100% free pipeline (Google News RSS + Publisher RSS + deterministic analysis) without any paid API keys
USE_FREE_ONLY=true

# Alpha Vantage API Key for Macro Fundamentals (https://www.alphavantage.co)
ALPHA_VANTAGE_API_KEY=""

# Server Port
PORT=3000

