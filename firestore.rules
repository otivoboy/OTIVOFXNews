rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidUserProfile(data, userId) {
      return data.id == userId &&
             data.email is string &&
             data.email.size() <= 150 &&
             (!('name' in data) || (data.name is string && data.name.size() <= 100)) &&
             (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 500)) &&
             (!('accountTier' in data) || (data.accountTier is string && data.accountTier.size() <= 50)) &&
             (!('memberSince' in data) || (data.memberSince is string && data.memberSince.size() <= 50)) &&
             (!('tradingStyle' in data) || (data.tradingStyle is string && data.tradingStyle.size() <= 50)) &&
             (!('primaryCurrency' in data) || (data.primaryCurrency is string && data.primaryCurrency.size() <= 10)) &&
             (!('riskPreference' in data) || (data.riskPreference is string && data.riskPreference.size() <= 50)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 4000)) &&
             (!('watchlists' in data) || (data.watchlists is list && data.watchlists.size() <= 50)) &&
             (!('riskSettings' in data) || data.riskSettings is map) &&
             (!('alerts' in data) || data.alerts is map) &&
             (!('stats' in data) || data.stats is map) &&
             (!('isVerified' in data) || data.isVerified is bool) &&
             (!('registeredAtTimestamp' in data) || data.registeredAtTimestamp is number) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    // User profiles collection
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false; // PII protection: never list all users
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId);
      allow delete: if isOwner(userId) && isValidId(userId);
    }
  }
}
